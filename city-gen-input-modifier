//Declares genning state upon runnning scenario.
if (!state.setup)
{
  state.setup = true // Ensure this is only set once and never wiped.
  state.genning = false // Switch to true once set. This will only be re-assigned through script interactions
}

const city_sample_1 = 'You arrive at the city of Conio; its aged but sturdy stone walls looming over your sides as you hear a chain heft the gate. The two guards posted by the toll gate make way for you as you stroll through the mainstreet, your eyes wandering. The folk here are as ordinary as they come; wearing their practical attire, their figures mesh into a sea of dark, dry colors. '
const city_sample_2 = 'You arrive at the city of Westead; lively cheers come from beyond the newly-built walls as you pass by. The toll gate is largely left unguarded. The folk wearing bright colored clothes and feather hats catch your attention; one of them bumps into you, and after a quick exchange of apologies, you continue on your way.'
const city_samples = [city_sample_1, city_sample_2]

const modifier = (text) => {
  let modifiedText = text
  if(text.includes('/gencity')) 
  {   
    //Pushe sample city descriptions to context memory.
    state.memory.context = city_samples.join('\n')
    state.genning = true
    console.log('City gen commenced.')
    modifiedText = ''
  }
  
    // You must return an object with the text property defined. 
    return {text: modifiedText}
}

// Don't modify this part
modifier(text)

